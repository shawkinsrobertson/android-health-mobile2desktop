# Copy to .env.local (gitignored) and fill in real values.
#
# Server-only (no NEXT_PUBLIC_ prefix) — the dashboard reads Supabase from
# server components / route handlers, so the anon key never has to reach
# the browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Same project, same anon key -- needed client-side only for chat's
# Supabase Realtime subscriptions (new messages, unread dots). Safe to
# expose: the anon key isn't a secret, RLS is the real access boundary.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required for coach/client auth (magic link emails, /login, /join/[token]).
# Used to build the emailRedirectTo URL — set this to wherever the dashboard
# is actually reachable (http://localhost:3000 for local dev).
SITE_URL=http://localhost:3000

# Required for video calling (chat calls and calendar events) — see
# lib/daily.ts. Server-only; never sent to the browser.
DAILY_API_KEY=...

# Google Calendar sync (see lib/google-calendar.ts). From a Google Cloud
# project's OAuth 2.0 Client ID (APIs & Services -> Credentials). Add
# ${SITE_URL}/api/calendar/google/callback as an Authorized redirect URI
# there for every environment that needs to connect a Google Calendar
# (e.g. http://localhost:3000/api/calendar/google/callback for local dev).
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Symmetric key this app uses (lib/calendar-crypto.ts, Node's own
# crypto module) to encrypt calendar_connections' OAuth tokens before
# they're ever written to Postgres, and decrypt them after reading --
# Postgres itself never sees a plaintext token or holds this key, it
# just stores an opaque ciphertext column. A real secret, not a
# placeholder -- generate one with `openssl rand -base64 32`.
CALENDAR_TOKEN_ENC_KEY=...

# Booking confirmation emails (see lib/email.ts) -- Resend API key, from
# resend.com's dashboard (API Keys). No SMTP setup needed.
RESEND_API_KEY=...

# The "from" address confirmation emails send from. Defaults to Resend's
# own sandbox sender (onboarding@resend.dev) if left unset, which works
# immediately with no setup -- but Resend restricts that address to only
# deliver to the Resend account's own verified email, so real bookers
# won't receive anything until a real sending domain is verified in
# Resend and this is pointed at an address on it (e.g.
# bookings@yourdomain.com).
BOOKING_EMAIL_FROM=onboarding@resend.dev

# Per-client AI assistant (see lib/assistant.ts, lib/assistant-tools.ts,
# app/api/clients/[clientId]/assistant/route.ts) -- an Anthropic API key
# from console.anthropic.com. Server-only; never sent to the browser, and
# the model itself is never given this client's name, email, or any other
# identifying detail -- only the numbers/dates its tools return.
ANTHROPIC_API_KEY=...
